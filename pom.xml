<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.xiaowuiot</groupId>
    <artifactId>iot-protocol-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>iot-protocol-gateway</name>
    <description>基于 Netty 的国标 IoT 协议接入网关：JT/T 808、JT/T 1078、HJ212，附设备模拟器</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- 协议库要求 JDK 8+，始终参与构建 -->
    <modules>
        <module>iot-protocols</module>
    </modules>

    <profiles>
        <!-- 网关和模拟器是 Spring Boot 3 应用，需要 JDK 17+，用低版本 JDK 构建时自动跳过 -->
        <profile>
            <id>apps</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <modules>
                <module>iot-gateway</module>
                <module>iot-simulator</module>
            </modules>
        </profile>
    </profiles>
</project>
